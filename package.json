{
  "name": "cursor-apollo-sandbox",
  "displayName": "Cursor Apollo Sandbox",
  "description": "Fill Apollo Server Sandbox in Cursor's embedded browser — operation, variables, headers, and authenticated runs.",
  "version": "0.1.0",
  "publisher": "oleh-helei",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Boobuh/cursor-apollo-sandbox.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:apolloSandbox.captureAuth",
    "onCommand:apolloSandbox.fillSandbox",
    "onCommand:apolloSandbox.runExport",
    "onCommand:apolloSandbox.setupExportTemplate",
    "onCommand:apolloSandbox.openGraphql"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "apolloSandbox.captureAuth",
        "title": "Apollo Sandbox: Capture Auth",
        "category": "Apollo Sandbox"
      },
      {
        "command": "apolloSandbox.fillSandbox",
        "title": "Apollo Sandbox: Fill Sandbox",
        "category": "Apollo Sandbox"
      },
      {
        "command": "apolloSandbox.runExport",
        "title": "Apollo Sandbox: Run Operation (parent fetch)",
        "category": "Apollo Sandbox"
      },
      {
        "command": "apolloSandbox.setupExportTemplate",
        "title": "Apollo Sandbox: Setup Sandbox (auth + fill)",
        "category": "Apollo Sandbox"
      },
      {
        "command": "apolloSandbox.openGraphql",
        "title": "Apollo Sandbox: Open GraphQL Endpoint",
        "category": "Apollo Sandbox"
      }
    ],
    "configuration": {
      "title": "Apollo Sandbox",
      "properties": {
        "apolloSandbox.catalogUrl": {
          "type": "string",
          "default": "",
          "description": "App page used to capture Bearer token (must trigger /graphql while logged in)."
        },
        "apolloSandbox.graphqlUrl": {
          "type": "string",
          "default": "http://localhost:4000/graphql",
          "description": "Apollo Server landing page / GraphQL endpoint URL."
        },
        "apolloSandbox.sandboxWaitMs": {
          "type": "number",
          "default": 9000,
          "description": "Milliseconds to wait after reloading the Sandbox iframe."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "watch": "tsc -watch -p .",
    "package": "vsce package",
    "lint": "tsc -p . --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.5.0"
  }
}